/** The request fields this middleware reads. Structurally matches the framework's RequestContext. */
export interface {{base}}Request {
  readonly method: string;
  readonly url: URL;
}

/** Everything the `{{base}}` middleware needs. Passed to the factory; nothing is looked up. */
export interface {{base}}MiddlewareDeps {
  readonly log: (line: string) => void;
}

/** Generated by `tsir make:middleware`. Dependencies arrive as the factory argument. */
export function create{{base}}Middleware(deps: {{base}}MiddlewareDeps) {
  return async (ctx: {{base}}Request, next: () => Promise<Response> | Response): Promise<Response> => {
    const response = await next();
    deps.log(`${ctx.method} ${ctx.url.pathname} ${String(response.status)}`);
    return response;
  };
}
