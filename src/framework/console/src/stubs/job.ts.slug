import { defineJob } from '@tsir/queue';

/** The payload is stored in the queue table, so keep it JSON-serialisable. */
export interface {{base}}JobPayload {
  readonly id: string;
}

// Generated by `tsir make:job`. Export it from the entry's `jobs` array so the worker can run it.
export const {{base}}Job = defineJob<{{base}}JobPayload>({
  // Unique in the project: it is what the worker looks up and what `queue:failed` prints.
  name: '{{stem}}',
  description: '{{stem}}',
  maxAttempts: 5,
  // Use the context `id` as the idempotency key: it is stable across retries.
  handle(context) {
    context.log(`{{stem}} ${context.payload.id}`);
  },
});
