import { defineListener } from '@tsir/events';

import { {{eventBase}}Event } from '../events/{{eventStem}}.event.ts';

// Generated by `tsir make:listener`. Export it in the `listeners` array of the entry's
// `createEvents(...)`. Its payload is typed by {{eventBase}}Event.
export const {{base}}Listener = defineListener({{eventBase}}Event, {
  // Unique within the event. It is part of the job name, so renaming it renames a job.
  name: '{{stem}}',
  handle(context) {
    // `context.id` is the idempotency key: stable across retries and relays.
    context.log(`{{stem}} ${context.payload.id} (${context.id})`);
  },
});
