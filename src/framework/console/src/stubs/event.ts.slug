import { defineEvent } from '@tsir/events';

/** The payload every listener of this event receives. */
export interface {{base}}EventPayload {
  readonly id: string;
}

// Generated by `tsir make:event`. The dotted name is the public contract: a broker, a log line
// and an outbox row all carry it, so rename it only with a migration.
export const {{base}}Event = defineEvent<{{base}}EventPayload>({
  name: '{{eventName}}',
  mode: 'queued',
});
