{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,{{jsx}}{{allowImportingTsExtensions}}
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"{{svelteInclude}}, "vite.config.ts"]
}
